<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Базовая тема С ActionBar (чтобы меню отображалось) -->
    <style name="Base.Theme.Resources" parent="Theme.Material3.DayNight">
        <!-- Основные цвета -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorSecondary">@color/colorAccent</item>
        <item name="colorOnPrimary">@android:color/white</item>

        <!-- Фон окна (будет автоматически меняться при повороте) -->
        <item name="android:windowBackground">@drawable/background</item>
    </style>

    <!-- Стиль для текста -->
    <style name="SpecialText">
        <item name="android:textSize">28sp</item>
        <item name="android:textColor">#548f00</item>
        <item name="android:background">#b7e4fb</item>
        <item name="android:textStyle">bold</item>
        <item name="android:padding">12dp</item>
        <item name="android:gravity">center</item>
    </style>

    <!-- Главная тема приложения -->
    <style name="Theme.Resources" parent="Base.Theme.Resources" />

</resources>